    "coordinateSystem": {
      "originLat": 36.549777,
      "originLon": 128.731262,
      "axes": "+X = East (m), +Z = South (m)",
      "urbanGridRotationYDeg": 6.5,
      "tiltedFrameFormula": {
        "u_eastTilt": "X * cos(6.5 deg) - Z * sin(6.5 deg)",
        "v_southTilt": "X * sin(6.5 deg) + Z * cos(6.5 deg)",
        "note": "In Roblox CFrame.Angles(0, math.rad(6.5), 0), local +X maps to (+cos 6.5, 0, -sin 6.5) and local +Z maps to (+sin 6.5, 0, +cos 6.5). Every building row in VWorldBlocks.luau around the school has rotationY ~ +6.5 deg (EW) or -83.5 deg (NS)."
      }
    }
  },
